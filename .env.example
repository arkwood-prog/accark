# Copy this file to ".env" and fill in your own values.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Mac / Linux:         cp .env.example .env
#
# The app loads .env automatically on every run, so you set these once and
# never type them again. .env is gitignored — it must never be committed.

# Free key from https://the-odds-api.com — needed for live upcoming fixtures.
ODDS_API_KEY=paste-your-key-here

# Password for the dashboard. Anyone on your network who has the URL needs
# this. Leave blank to run with no password (fine on a trusted home network).
BETTINGEDGE_TOKEN=

# Optional second provider, from https://www.api-football.com
# API_FOOTBALL_KEY=
